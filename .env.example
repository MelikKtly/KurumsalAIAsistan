# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b

# Prompt versiyonu (app/prompts/rag/<versiyon>.yaml)
RAG_PROMPT_VERSION=v2

# Cevabı ikinci bir LLM çağrısıyla bağlama göre doğrula (açıkken ~2 kat yavaş)
GROUNDEDNESS_CHECK=true

# Embedding (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chroma
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=kurumsal_docs

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4

# Maliyet tahmini için referans API modeli (fiyatlar app/pricing.yaml'da)
COST_REFERENCE_MODEL=claude-sonnet-5-5

# (Opsiyonel, kapalı) LangSmith izleme — LangChain bu değişkenler tanımlıysa tüm zincir/LLM
# çağrılarını otomatik olarak LangSmith'e gönderir; kod değişikliği gerekmez.
# Dikkat: sorular ve doküman parçaları LangSmith sunucularına gider (kurumsal veri!).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<langsmith.com'dan alınan anahtar>
# LANGSMITH_PROJECT=kurumsal-ai-asistan

# Agent (Faz 3) prompt versiyonu: app/prompts/agent/<versiyon>.yaml
AGENT_PROMPT_VERSION=v3

# İlişkisel veritabanı (sorgu geçmişi + çalışan tablosu). Lokal: SQLite; Docker Compose'da PostgreSQL'e ayarlanır.
DATABASE_URL=sqlite:///data/app.db

# Log seviyesi (JSON loglar stdout'a): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
