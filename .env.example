# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b

# Embedding (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chroma
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=kurumsal_docs

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4
